PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lumiere
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of sites allowed to call the API (your storefront URL)
ALLOWED_ORIGIN=http://localhost:5500
# Public HTTPS URL of THIS server (Safaricom must reach it). Use ngrok while testing.
PUBLIC_URL=https://your-api.example.com

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@lumiere.example
ADMIN_PASSWORD=choose-a-strong-password

# M-Pesa Daraja (sandbox values from developer.safaricom.co.ke)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TXN_TYPE=CustomerPayBillOnline
# Random string placed in the callback URL so only Safaricom's address is accepted
MPESA_CALLBACK_SECRET=change-me-random
